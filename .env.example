# Local development defaults. For production on Railway, PORT should be 8080
# and PUBLIC_BASE_URL / *_REDIRECT_URI must point at your deployed domain.
PORT=8080
SESSION_SECRET=replace-with-a-long-random-value
PUBLIC_BASE_URL=https://rival-audio-converter-production.up.railway.app
ROBLOX_CLIENT_ID=your-roblox-oauth-client-id
ROBLOX_CLIENT_SECRET=your-roblox-oauth-client-secret
ROBLOX_REDIRECT_URI=https://rival-audio-converter-production.up.railway.app/auth/roblox/callback
ROBLOX_ASSET_DESCRIPTION=Audio uploaded from Rival Audio Converter
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# This MUST match EXACTLY (protocol, domain, casing, no trailing slash) the
# "Authorized redirect URI" configured in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://rival-audio-converter-production.up.railway.app/auth/google/callback
