{
  "name": "rival-roblox-audio-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Audio converter and Roblox Open Cloud uploader",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "node --watch server.js",
    "dev:client": "vite --host localhost --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "check": "node --check server.js && vite build --config client/vite.config.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "connect-sqlite3": "^0.9.18",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
